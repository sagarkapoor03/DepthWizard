# DEPTHWIZARD — root environment template
# Copy to .env (backend reads DW_* via pydantic-settings) and mirror
# NEXT_PUBLIC_API_URL into frontend/.env.local

# ---- Frontend → Backend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend ----
# Comma-separated CORS origins
DW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload / processing limits
DW_MAX_UPLOAD_MB=30
DW_MAX_IMAGE_SIDE=1536
DW_MESH_MAX_CELLS=240

# AI depth model (any Depth-Anything-V2 HF checkpoint)
DW_DEPTH_MODEL_NAME=depth-anything/Depth-Anything-V2-Small-hf
DW_DEPTH_INPUT_SIZE=518

# true → force clearly-labelled synthetic fallback depth (no downloads)
DW_FORCE_FALLBACK=false
